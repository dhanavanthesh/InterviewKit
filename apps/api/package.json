{
  "name": "@interview-kit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n db,api -c gray,blue \"tsx ../../scripts/local-mongo.ts\" \"tsx ../../scripts/wait-for-port.ts 27017 && tsx watch src/server.ts\"",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "dev:server": "tsx watch src/server.ts"
  },
  "dependencies": {
    "@interview-kit/core": "*",
    "@interview-kit/logic": "*",
    "@interview-kit/schema": "*",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "mongoose": "^8.18.1",
    "multer": "^2.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0"
  }
}
